# Copy to .env.local and fill in. See the README's "API keys" table.

# Required: Gemini (item detection + visual check). Free tier at aistudio.google.com
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=15

# Strongly recommended: SerpApi (Google Lens + Google Shopping). Free plan: 250 searches/month
SERPAPI_KEY=
# Optional: paid searches one board may spend (default 30)
# MAX_SEARCHES_PER_BOARD=30

# Optional: eBay Browse API (both required together)
EBAY_APP_ID=
EBAY_CERT_ID=

# Required for a public deployment: Cloudflare Turnstile bot check (free).
# Leave both empty for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames the bot check may come from (production only), e.g. shop-pin.onrender.com
TURNSTILE_HOSTNAMES=

# Optional, disabled by default (no free tier)
# RAINFOREST_API_KEY=
